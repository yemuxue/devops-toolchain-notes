<mxfile host="app.diagrams.net" modified="2026-11-10T00:00:00.000Z" agent="dsh" version="24.0.0">
  <diagram id="flow16" name="16阶段流程">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="需求工程 16 阶段流程 × 产品职责" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value='&lt;font color="#1D4ED8"&gt;■ 做什么（目标 + 产品 + 参与）&lt;/font&gt;　　&lt;font color="#475569"&gt;■ 不做什么（括号内为归属）&lt;/font&gt;　　左侧大括号 = &lt;b&gt;工具域&lt;/b&gt;　最左竖条 = &lt;b&gt;ALM 平台（贯穿）&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="30" y="86" width="1340" height="24" as="geometry"/></mxCell>
        <mxCell id="b1" value="定义阶段（阶段 1-5）" style="rounded=1;arcSize=2;html=1;fillColor=#E9EEFB;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#A3AEBF;" vertex="1" parent="1"><mxGeometry x="60" y="156" width="1320" height="602" as="geometry"/></mxCell>
        <mxCell id="b2" value="设计阶段（阶段 6-8）" style="rounded=1;arcSize=2;html=1;fillColor=#EFEAFB;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#A3AEBF;" vertex="1" parent="1"><mxGeometry x="60" y="746" width="1320" height="366" as="geometry"/></mxCell>
        <mxCell id="b3" value="实现阶段（阶段 9）" style="rounded=1;arcSize=2;html=1;fillColor=#E6F4F1;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#A3AEBF;" vertex="1" parent="1"><mxGeometry x="60" y="1100" width="1320" height="130" as="geometry"/></mxCell>
        <mxCell id="b4" value="验证阶段（阶段 10-13）" style="rounded=1;arcSize=2;html=1;fillColor=#FBF1DF;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#A3AEBF;" vertex="1" parent="1"><mxGeometry x="60" y="1218" width="1320" height="484" as="geometry"/></mxCell>
        <mxCell id="b5" value="交付阶段（阶段 14）" style="rounded=1;arcSize=2;html=1;fillColor=#E5F0F8;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#A3AEBF;" vertex="1" parent="1"><mxGeometry x="60" y="1690" width="1320" height="130" as="geometry"/></mxCell>
        <mxCell id="b6" value="治理阶段（阶段 15-16）" style="rounded=1;arcSize=2;html=1;fillColor=#EEF1F5;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#A3AEBF;" vertex="1" parent="1"><mxGeometry x="60" y="1808" width="1320" height="248" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;1&lt;/b&gt;　需求获取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="186" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="t8" value="目标：谁、在什么场景、想要什么　　&lt;b&gt;产品&lt;/b&gt;：访谈与场景梳理、干系人清单与需求池质量　　&lt;b&gt;参与&lt;/b&gt;：业务目标对齐、竞品分析" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="190" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t9" value="&lt;b&gt;不做&lt;/b&gt;：需求池工具配置、字段与工作流（→研发/工具链范围）、访谈录音转写与归档（可由助理或 AI 完成）、法务与合规判断（→法务/合规范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="246" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;b&gt;2&lt;/b&gt;　需求分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="304" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s7" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t12" value="目标：哪些做、先做哪个、冲突怎么解　　&lt;b&gt;产品&lt;/b&gt;：需求分类、优先级、范围裁剪、冲突识别与裁决提议　　&lt;b&gt;参与&lt;/b&gt;：技术可行性、成本与工期估算" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="308" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t13" value="&lt;b&gt;不做&lt;/b&gt;：架构方案与技术选型（→架构/研发范围）、合规与法务判定（→法务范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="364" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s14" value="&lt;b&gt;3&lt;/b&gt;　需求规格化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="422" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s10" target="s14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t16" value="目标：怎么写成可验证、可追溯的需求　　&lt;b&gt;产品&lt;/b&gt;：需求分层与措辞、验收标准、需求编号规则制定　　&lt;b&gt;参与&lt;/b&gt;：需求评审会、属性字段设计" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="426" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t17" value="&lt;b&gt;不做&lt;/b&gt;：DOORS 模块/属性搭建（→研发范围）、DXL 脚本、批量导入（→研发范围）、合规工作产品清单（→质量/过程范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="482" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s18" value="&lt;b&gt;4&lt;/b&gt;　需求评审" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="540" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s14" target="s18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t20" value="目标：有没有错、漏、歧义　　&lt;b&gt;产品&lt;/b&gt;：组织评审、准备材料、跟踪闭环、决议草稿与整改任务分派　　&lt;b&gt;参与&lt;/b&gt;：评审结论签认、评审流程与检查单模板" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="544" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t21" value="&lt;b&gt;不做&lt;/b&gt;：评审流程定义与合规判定（→质量/过程范围）、工具配置与模板开发（→研发/工具链范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="600" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s22" value="&lt;b&gt;5&lt;/b&gt;　需求基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="658" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s18" target="s22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t24" value="目标：什么时候冻结，冻结哪一版　　&lt;b&gt;产品&lt;/b&gt;：决定基线时机与范围、基线说明与对外发布口径　　&lt;b&gt;参与&lt;/b&gt;：基线策略与版本号规则、基线评审" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="662" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t25" value="&lt;b&gt;不做&lt;/b&gt;：基线创建与比对操作（→ CM/工具链范围）、配置管理流程定义（→质量/过程范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="718" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s26" value="&lt;b&gt;6&lt;/b&gt;　架构设计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="776" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s22" target="s26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t28" value="目标：系统由哪些部分组成　　&lt;b&gt;产品&lt;/b&gt;：提供需求输入与业务约束、评审架构对需求的覆盖　　&lt;b&gt;参与&lt;/b&gt;：架构方案评审、接口的业务语义" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="780" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t29" value="&lt;b&gt;不做&lt;/b&gt;：UML/SysML 建模（→架构师范围）、技术选型、性能与容量设计（→架构/研发范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="836" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s30" value="&lt;b&gt;7&lt;/b&gt;　详细设计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="894" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s26" target="s30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t32" value="目标：模块内部怎么实现　　&lt;b&gt;产品&lt;/b&gt;：校验设计覆盖需求与业务规则、确认业务异常与边界处理　　&lt;b&gt;参与&lt;/b&gt;：接口契约评审、设计评审" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="898" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t33" value="&lt;b&gt;不做&lt;/b&gt;：详细设计本身（→研发范围）、代码规范与实现细节（→研发范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="954" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s34" value="&lt;b&gt;8&lt;/b&gt;　需求分配" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1012" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e35" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s30" target="s34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t36" value="目标：每条需求由谁实现　　&lt;b&gt;产品&lt;/b&gt;：分配原则与业务边界、确认每条需求有归属　　&lt;b&gt;参与&lt;/b&gt;：组件划分、跨团队需求协调" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1016" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t37" value="&lt;b&gt;不做&lt;/b&gt;：分配矩阵在模型/需求库中的维护（→研发/工具链范围）、组件技术边界定义（→架构师范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1072" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s38" value="&lt;b&gt;9&lt;/b&gt;　编码实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1130" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s34" target="s38"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t40" value="目标：把需求写成代码　　&lt;b&gt;产品&lt;/b&gt;：需求澄清与验收、实现优先级排序　　&lt;b&gt;参与&lt;/b&gt;：技术方案评审、代码评审" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1134" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t41" value="&lt;b&gt;不做&lt;/b&gt;：编写生产代码（→研发范围）、分支策略、代码规范、合并发布（→研发范围）、环境与依赖管理（→研发/运维范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1190" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s42" value="&lt;b&gt;10&lt;/b&gt;　单元测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1248" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e43" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s38" target="s42"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t44" value="目标：函数和类是否正确　　&lt;b&gt;产品&lt;/b&gt;：关注关键需求是否被单测覆盖、确认缺陷修复有回归　　&lt;b&gt;参与&lt;/b&gt;：覆盖率目标设定、测试策略" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1252" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t45" value="&lt;b&gt;不做&lt;/b&gt;：编写与维护单测（→研发范围）、流水线与门禁配置（→研发/测试开发范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1308" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s46" value="&lt;b&gt;11&lt;/b&gt;　集成测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1366" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e47" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s42" target="s46"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t48" value="目标：模块之间能不能通　　&lt;b&gt;产品&lt;/b&gt;：确认接口类需求被覆盖、确认跨系统业务规则　　&lt;b&gt;参与&lt;/b&gt;：联调计划与时间窗、接口变更通知" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1370" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t49" value="&lt;b&gt;不做&lt;/b&gt;：环境搭建与依赖准备（→运维/测试开发范围）、自动化脚本编写（→测试开发范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1426" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s50" value="&lt;b&gt;12&lt;/b&gt;　系统测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1484" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s46" target="s50"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t52" value="目标：端到端是否符合系统需求　　&lt;b&gt;产品&lt;/b&gt;：验收标准与通过门槛、业务场景与数据准备　　&lt;b&gt;参与&lt;/b&gt;：测试方案评审、缺陷优先级判定" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1488" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t53" value="&lt;b&gt;不做&lt;/b&gt;：用例设计与执行（→测试范围）、缺陷根因分析（→研发范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1544" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s54" value="&lt;b&gt;13&lt;/b&gt;　验收测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1602" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e55" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s50" target="s54"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t56" value="目标：业务是否接受　　&lt;b&gt;产品&lt;/b&gt;：组织 UAT、判定是否通过、验收标准解释与争议裁决　　&lt;b&gt;参与&lt;/b&gt;：遗留缺陷豁免、上线时间窗" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1606" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t57" value="&lt;b&gt;不做&lt;/b&gt;：验收环境准备（→运维范围）、缺陷修复（→研发范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1662" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s58" value="&lt;b&gt;14&lt;/b&gt;　发布上线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369A1;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1720" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e59" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s54" target="s58"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t60" value="目标：何时、发多少、怎么回滚　　&lt;b&gt;产品&lt;/b&gt;：上线范围、时间窗、灰度比例、发布说明与业务通知　　&lt;b&gt;参与&lt;/b&gt;：发布方案与回滚预案、业务监控指标" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1724" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t61" value="&lt;b&gt;不做&lt;/b&gt;：流水线配置、镜像构建（→研发范围）、K8s 部署、扩缩容（→运维/SRE 范围）、告警规则与值班（→ SRE 范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1780" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s62" value="&lt;b&gt;15&lt;/b&gt;　变更控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1838" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e63" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s58" target="s62"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t64" value="目标：改不改、影响谁、谁批　　&lt;b&gt;产品&lt;/b&gt;：变更必要性与优先级、影响范围确认与需求文本更新　　&lt;b&gt;参与&lt;/b&gt;：变更审批（CCB）、技术影响评估" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1842" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t65" value="&lt;b&gt;不做&lt;/b&gt;：变更单系统配置与流程（→工具链/质量范围）、回归测试执行与代码修改（→测试/研发范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1898" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="s66" value="&lt;b&gt;16&lt;/b&gt;　追溯与度量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366" y="1956" width="172" height="78" as="geometry"/></mxCell>
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA9BF;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s62" target="s66"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t68" value="目标：每条需求能否追到底、过程可不可度量　　&lt;b&gt;产品&lt;/b&gt;：指标口径（什么算“覆盖/通过”）、覆盖率目标与复盘改进　　&lt;b&gt;参与&lt;/b&gt;：数据源接入方案、指标实现与校验" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1D4ED8;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="1960" width="820" height="52" as="geometry"/></mxCell>
        <mxCell id="t69" value="&lt;b&gt;不做&lt;/b&gt;：数据管道、埋点开发（→研发范围）、BI 建模与看板制作（→ BI/数据范围）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#475569;spacing=0;" vertex="1" parent="1"><mxGeometry x="556" y="2016" width="820" height="46" as="geometry"/></mxCell>
        <mxCell id="br70" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#1D4ED8;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="178" width="16" height="212" as="geometry"/></mxCell>
        <mxCell id="d71" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;协作与任务&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 1-2&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Jira、Confluence&lt;br&gt;&lt;font color='#8A94A6'&gt;国产替代：禅道&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#1D4ED8;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="178" width="258" height="212" as="geometry"/></mxCell>
        <mxCell id="br72" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#1D4ED8;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="414" width="16" height="330" as="geometry"/></mxCell>
        <mxCell id="d73" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;需求管理&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 3-5&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;IBM DOORS（追溯、基线）、Polarion（ALM 一体化）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#1D4ED8;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="414" width="258" height="330" as="geometry"/></mxCell>
        <mxCell id="br74" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#6D28D9;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="768" width="16" height="94" as="geometry"/></mxCell>
        <mxCell id="d75" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;架构设计&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 6-6&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;EA（UML/SysML）、Rhapsody（可仿真）、Cameo（MBSE）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6D28D9;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="768" width="258" height="94" as="geometry"/></mxCell>
        <mxCell id="br76" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#6D28D9;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="886" width="16" height="212" as="geometry"/></mxCell>
        <mxCell id="d77" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;详细设计与分配&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 7-8&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;PlantUML（文本建模）、OpenAPI（接口契约）、EA、DOORS（分配）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6D28D9;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="886" width="258" height="212" as="geometry"/></mxCell>
        <mxCell id="br78" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#0F766E;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="1122" width="16" height="94" as="geometry"/></mxCell>
        <mxCell id="d79" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;代码与 CI&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 9-9&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Git（版本控制）、GitLab CI、Jenkins（流水线）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#0F766E;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="1122" width="258" height="94" as="geometry"/></mxCell>
        <mxCell id="br80" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#B45309;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="1240" width="16" height="448" as="geometry"/></mxCell>
        <mxCell id="d81" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;测试与质量&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 10-13&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;TestRail（用例）、Jira（缺陷）、SonarQube（静态扫描）、Trivy（安全扫描）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#B45309;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="1240" width="258" height="448" as="geometry"/></mxCell>
        <mxCell id="br82" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#0369A1;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="1712" width="16" height="94" as="geometry"/></mxCell>
        <mxCell id="d83" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;交付与运维&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 14-14&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Nexus（制品）、Harbor（镜像）、Docker / K8s（容器）、Argo CD / Helm（部署）、Prometheus / Grafana（监控）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#0369A1;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="1712" width="258" height="94" as="geometry"/></mxCell>
        <mxCell id="br84" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#475569;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="1830" width="16" height="94" as="geometry"/></mxCell>
        <mxCell id="d85" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;变更控制&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 15-15&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;DOORS 变更单、Jira Workflow（审批）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="1830" width="258" height="94" as="geometry"/></mxCell>
        <mxCell id="br86" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=0;size=0.5;flipH=1;strokeColor=#475569;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="336" y="1948" width="16" height="94" as="geometry"/></mxCell>
        <mxCell id="d87" value="&lt;div style='line-height:1.25'&gt;&lt;b&gt;度量报表&lt;/b&gt;　&lt;font style='font-size:9px;color:#8A94A6'&gt;阶段 16-16&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Power BI（看板）、Tableau（分析）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="72" y="1948" width="258" height="94" as="geometry"/></mxCell>
        <mxCell id="alm" value="ALM 平台（贯穿全流程）　IBM ELM · Codebeamer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=none;fontColor=#475569;fontSize=11;fontStyle=1;horizontal=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="14" y="178" width="44" height="1864" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>